# ---------------------------------------------------------------------------
# AI Monster - example environment variables
# ---------------------------------------------------------------------------
# Copy to `.env` and adjust as needed. None of these are strictly required:
# the app ships with sensible defaults. These mainly let you override the
# Amazon Bedrock model IDs and tweak CORS / region at deploy time.
#
# How these are consumed:
#   - BEDROCK_MODEL_* : read by the chat Lambda (packages/backend/src/config.ts)
#                       and passed through by the CDK app (infra/bin/app.ts).
#   - AWS_REGION      : standard AWS SDK / CLI region. Lambda sets this itself;
#                       locally it selects where `cdk deploy` provisions.
#   - ALLOWED_ORIGIN  : CORS Access-Control-Allow-Origin for the API.
# ---------------------------------------------------------------------------

# --- Amazon Bedrock model overrides (optional) -----------------------------
# Defaults live in packages/shared/src/bedrock-models.ts (BEDROCK_MODEL_IDS).
# 成長期 (Rookie) -> Haiku
BEDROCK_MODEL_HAIKU=anthropic.claude-3-5-haiku-20241022-v1:0
# 成熟期 (Champion) -> Sonnet
BEDROCK_MODEL_SONNET=anthropic.claude-3-5-sonnet-20241022-v2:0
# 完全体 (Ultimate) -> Opus
BEDROCK_MODEL_OPUS=anthropic.claude-3-opus-20240229-v1:0

# --- AWS deployment ---------------------------------------------------------
# Region to deploy into. us-east-1 is recommended because Claude model
# availability (especially Opus) is broadest there.
AWS_REGION=us-east-1

# --- API CORS ---------------------------------------------------------------
# "*" allows any origin (simplest). Lock down to your CloudFront URL for prod,
# e.g. ALLOWED_ORIGIN=https://d1234abcd.cloudfront.net
ALLOWED_ORIGIN=*
