<mxfile host="app.diagrams.net" type="device">
  <diagram name="Architecture" id="aimonster-arch">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="AI Monster — Architecture" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="640" height="30" as="geometry" />
        </mxCell>

        <!-- Client -->
        <mxCell id="client" value="User (Web Browser)&#10;React + Vite SPA&#10;EN / JA (i18n)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- AWS boundary -->
        <mxCell id="aws" value="AWS Cloud (us-east-1)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#232F3E;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=13;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="840" height="600" as="geometry" />
        </mxCell>

        <!-- CloudFront -->
        <mxCell id="cf" value="Amazon CloudFront&#10;HTTPS redirect, OAC&#10;SPA 403/404 -&gt; index.html" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#945DF2;gradientDirection=north;fillColor=#5A30B5;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1">
          <mxGeometry x="350" y="140" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- S3 -->
        <mxCell id="s3" value="Amazon S3 (private)&#10;Block Public Access ALL&#10;frontend dist/ + config.json" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#60A337;gradientDirection=north;fillColor=#277116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="600" y="140" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- API Gateway -->
        <mxCell id="apigw" value="API Gateway&#10;HTTP API v2 (CORS)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#945DF2;gradientDirection=north;fillColor=#5A30B5;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1">
          <mxGeometry x="350" y="330" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- Lambdas -->
        <mxCell id="lgetMonster" value="getMonster&#10;Lambda" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="560" y="250" width="64" height="64" as="geometry" />
        </mxCell>
        <mxCell id="lsaveMonster" value="saveMonster&#10;Lambda" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="560" y="340" width="64" height="64" as="geometry" />
        </mxCell>
        <mxCell id="lbattle" value="battle&#10;Lambda" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="560" y="430" width="64" height="64" as="geometry" />
        </mxCell>
        <mxCell id="lchat" value="chat&#10;Lambda" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="560" y="540" width="64" height="64" as="geometry" />
        </mxCell>

        <!-- DynamoDB -->
        <mxCell id="ddb" value="Amazon DynamoDB&#10;DigitalMonsterStack-Monsters&#10;PK = id · PAY_PER_REQUEST" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="840" y="330" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- Bedrock -->
        <mxCell id="bedrock" value="Amazon Bedrock&#10;Anthropic Claude" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#60A337;gradientDirection=north;fillColor=#277116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="840" y="540" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- Notes -->
        <mxCell id="noteStages" value="Chat model tier by growth stage:&#10;baby = canned reply (NO Bedrock call)&#10;rookie = Claude Haiku · champion = Claude Sonnet · ultimate = Claude Opus&#10;Only the chat Lambda has bedrock:InvokeModel." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#01A88D;fillColor=#f0faf8;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="960" y="540" width="160" height="110" as="geometry" />
        </mxCell>
        <mxCell id="noteCdk" value="Infrastructure as code: AWS CDK (TypeScript, infra/).&#10;CDK BucketDeployment uploads frontend dist/ + config.json {apiBaseUrl} to S3." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#b85450;fillColor=#fdecea;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="720" y="140" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="client" target="cf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="OAC (SigV4) · serves static site" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="cf" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="reads config.json then calls API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="client" target="apigw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- API Gateway -> Lambdas (labeled with routes) -->
        <mxCell id="r1" value="GET /monster/{monsterId}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="apigw" target="lgetMonster">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="POST /monster" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="apigw" target="lsaveMonster">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="POST /battle" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="apigw" target="lbattle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="POST /chat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="apigw" target="lchat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lambdas -> DynamoDB -->
        <mxCell id="d1" value="R/W" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="lgetMonster" target="ddb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="W" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="lsaveMonster" target="ddb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="R/W" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="lbattle" target="ddb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="lchat" target="ddb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- chat -> Bedrock (ONLY chat) -->
        <mxCell id="b1" value="bedrock:InvokeModel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=9;strokeColor=#01A88D;fontColor=#01A88D;strokeWidth=1.5;" edge="1" parent="1" source="lchat" target="bedrock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
