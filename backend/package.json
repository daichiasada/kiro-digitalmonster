{
  "name": "@digital-monster/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API Gateway + Lambda handlers (TypeScript) for the digital monster: load/save/train/chat with DynamoDB persistence and stage-gated Amazon Bedrock conversation.",
