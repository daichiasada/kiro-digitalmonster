{
  "name": "digital-monster",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack TypeScript digital monster (Tamagotchi/Digimon-style) web app monorepo.",
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "infra"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
